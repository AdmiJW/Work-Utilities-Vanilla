{
  "name": "work-utilities-vanilla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/develop.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts e2e *.mjs --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "check": "npm run lint && npm run check:boundaries && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "ag-grid-community": "36.2.0",
    "dexie": "4.4.7",
    "exceljs": "4.4.0",
    "jsonc-parser": "3.3.1",
    "lucide": "1.61.0",
    "sql-formatter": "15.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  }
}
